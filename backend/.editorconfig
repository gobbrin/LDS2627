root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Regras de estilo, segurança e robustez: não reduzir a severidade dos diagnósticos do SDK.
dotnet_analyzer_diagnostic.category-Security.severity = warning
dotnet_analyzer_diagnostic.category-Reliability.severity = warning
dotnet_analyzer_diagnostic.category-Performance.severity = suggestion

dotnet_diagnostic.CA1062.severity = suggestion

# Código de produção: complexidade e código morto (BE-19, R-B05, R-Q01/R-Q02).
[src/**.cs]
# CA1502: complexidade ciclomática acima de 15 (limite em CodeMetricsConfig.txt). CA1505: índice de manutenção baixo.
dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1505.severity = warning
# Código morto: membro privado sem uso (IDE0051), membro privado escrito e nunca lido (IDE0052), parâmetro sem uso (IDE0060).
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

# Migrations geradas pelo EF Core: não formatar nem analisar.
[src/CampusCarpool.Infrastructure/Migrations/**.cs]
generated_code = true

# Testes: nomes com sublinhados por convenção (CT008_..., I110_59_...).
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
