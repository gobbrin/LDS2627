# Modelo do ficheiro backend/.env usado por docker-compose.sqlserver.yml.
# Copiar para .env (ignorado pelo git) ou deixar que scripts/testes-sqlserver.sh o crie.
# Só valores locais e fictícios: o repositório é público.

# Password do utilizador sa do SQL Server local. Regras do SQL Server: 8+ caracteres,
# com maiúsculas, minúsculas, algarismos e símbolos.
SQLSERVER_SENHA=MudarEsta-Local1!

# Porta na máquina (mudar se a 1433 já estiver ocupada).
SQLSERVER_PORTA=1433
