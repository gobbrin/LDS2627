{
  "info": {
    "name": "Campus Carpool - I034 a I037",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Definir baseUrl, token e viagemId. Requer API, SQL Server, email confirmado e Maps:ApiKey."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5100"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "viagemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "I034 - Consultar perfil",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/utilizadores/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "utilizadores",
            "me"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "I034 - Editar perfil",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/utilizadores/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "utilizadores",
            "me"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Gil Teste\",\n  \"curso\": \"Engenharia Informática\",\n  \"instituicao\": \"ESTG P.PORTO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "I035 - Criar viagem",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/viagens",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "viagens"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"origem\": \"Felgueiras, Portugal\",\n  \"destino\": \"Porto, Portugal\",\n  \"partidaEm\": \"2026-12-10T10:00:00Z\",\n  \"lugares\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code === 201) { pm.collectionVariables.set(\"viagemId\", pm.response.json().id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "I035 - Consultar viagem",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/viagens/{{viagemId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "viagens",
            "{{viagemId}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "I035 - Editar viagem",
