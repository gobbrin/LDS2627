{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CampusCarpoolDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "CampusCarpool",
    "Audience": "CampusCarpool.Clients"
  },
  "Maps": {
    "Provider": "OpenRouteService",
    "BaseUrl": "https://api.heigit.org/openrouteservice",
    "TimeoutSeconds": 10
  },
  "Custos": {
    "PrecoPorKm": 0.10
  },
  "Frontend": {
    "ConfirmUrl": "http://localhost:4200/confirmar-conta"
  }
}
