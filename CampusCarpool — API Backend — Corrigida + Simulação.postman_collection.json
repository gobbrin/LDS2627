    {
      "name": "04 — Gestão de viagens",
      "item": [
        {
          "name": "POST Criar viagem — guardar viagemId",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const date = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set(\"partidaFutura\", date.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Criar viagem devolve HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  let data; try { data = pm.response.json(); } catch (e) { console.error(\"Resposta não é JSON\", e); }",
                  "  const id = data && (data.id || data.Id || data.viagemId || data.ViagemId);",
                  "  pm.test(\"Resposta inclui GUID da viagem\", () => pm.expect(id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i));",
                  "  if (typeof id === \"string\" && /^[0-9a-f-]{36}$/i.test(id)) {",
                  "    pm.collectionVariables.set(\"viagemId\", id);",
                  "    if (pm.environment.name) pm.environment.set(\"viagemId\", id);",
                  "    console.log(\"viagemId guardado: \" + id);",
                  "  }",
                  "} else { console.warn(\"Viagem não criada: HTTP \" + pm.response.code + \". viagemId anterior mantido.\"); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origem\": \"{{origem}}\",\n  \"destino\": \"{{destino}}\",\n  \"partidaEm\": \"{{partidaFutura}}\",\n  \"lugares\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/viagens",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "viagens"
              ]
            },
            "description": "Partida futura gerada automaticamente +7 dias UTC; requer conta confirmada e mapas disponíveis."
          },
          "response": []
        },
