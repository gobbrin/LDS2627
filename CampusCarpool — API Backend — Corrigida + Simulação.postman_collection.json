        {
          "name": "POST Login — guardar JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login devolve HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  let data; try { data = pm.response.json(); } catch (e) { console.error(\"Resposta não é JSON\", e); }",
                  "  const token = data && (data.accessToken || data.AccessToken);",
                  "  pm.test(\"JWT presente na resposta\", () => pm.expect(token).to.be.a(\"string\").and.not.empty);",
                  "  if (typeof token === \"string\" && token.length > 0) {",
                  "    pm.collectionVariables.set(\"accessToken\", token);",
                  "    if (pm.environment.name) pm.environment.set(\"accessToken\", token);",
                  "    console.log(\"JWT guardado na coleção\" + (pm.environment.name ? \" e no ambiente \" + pm.environment.name : \"\") + \".\");",
                  "  }",
                  "} else { console.warn(\"Login sem sucesso: HTTP \" + pm.response.code + \". Token anterior mantido.\"); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/autenticacao/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "autenticacao",
                "login"
              ]
            }
          },
          "response": []
        },
